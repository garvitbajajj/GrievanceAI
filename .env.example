# ── Supabase Edge Function secrets ─────────────────────
# Set these in Supabase dashboard → Edge Functions → Secrets
# (or `supabase secrets set --env-file .env`). Frontend vars live in frontend/.env.example.

# Required
GEMINI_API_KEY=<YOUR_GEMINI_API_KEY>

# Optional: model fallback order (first that works wins)
GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.0-flash

# Optional: resolution + follow-up emails (Gmail App Password, not your login password)
GMAIL_USER=<YOUR_GMAIL_ADDRESS>
GMAIL_PASS=<YOUR_GMAIL_APP_PASSWORD>

# Optional: base URL used in email links
FRONTEND_URL=https://<your-app>.vercel.app
